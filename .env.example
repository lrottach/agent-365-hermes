# Copy to .env and fill in locally. Never commit .env.
# Planned settings for Phase 1. Names may change.

# Entra tenant that hosts the agent identity
A365_TENANT_ID=00000000-0000-0000-0000-000000000000

# Agent identity blueprint (app) and agent identity
A365_BLUEPRINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
A365_AGENT_ID=00000000-0000-0000-0000-000000000000

# Path to the blueprint certificate (PEM). Keep it outside the repo.
A365_CERT_PATH=/path/outside/repo/blueprint.pem
